name: Compilar APK de Prueba

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Descargar el código del repositorio
      uses: actions/checkout@v4

    - name: Configurar Java JDK 17
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'temurin'
        cache: gradle

    - name: Validar o Generar Gradle Wrapper
      run: |
        if [ ! -f gradlew ]; then
          echo "gradlew no encontrado, generando uno nuevo..."
          gradle wrapper
        fi
        chmod +x gradlew

    - name: Compilar APK (Modo Debug)
      run: ./gradlew clean assembleDebug --no-build-cache --no-configuration-cache

    - name: Guardar el archivo APK generado
      uses: actions/upload-artifact@v4
      with:
        name: EcoPos-Debug-APK
        path: app/build/outputs/apk/debug/app-debug.apk
